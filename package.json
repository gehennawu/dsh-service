{
  "name": "@gehennawu/dsh-service",
  "version": "0.10.0",
  "description": "DSH Web 自托管运维面板：安全重启、健康监控、备份和 Linux 权限维护。",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "restart",
    "web-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gehennawu/dsh-service.git"
  },
  "bugs": {
    "url": "https://github.com/gehennawu/dsh-service/issues"
  },
  "homepage": "https://github.com/gehennawu/dsh-service#readme",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  }
}
