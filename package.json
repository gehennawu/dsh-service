{
  "name": "@gehennawu/dsh-service",
  "version": "1.9.7",
  "description": "DSH Web 运维面板：安全重启、健康监控、备份和 Linux 权限维护。",
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/check-client-source.mjs",
    "pretest": "npm run build:client",
    "test": "node --test",
    "prepack": "npm run build:client"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "quota-adapters.js",
    "backup-integrity.js",
    "skill-routes.js",
    "session-routes.js",
    "quota-routes.js",
    "subagent-routes.js",
    "backup-routes.js",
    "plugin-health.js",
    "plugin-compat.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "screenshots",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "restart",
    "web-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gehennawu/dsh-service.git"
  },
  "bugs": {
    "url": "https://github.com/gehennawu/dsh-service/issues"
  },
  "homepage": "https://github.com/gehennawu/dsh-service#readme",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.1-rc.2 <0.1.7-alpha.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "terser": "^5.51.2"
  }
}
